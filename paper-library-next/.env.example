# 此文件是配置说明，不会自动读取。Shell 使用 export；systemd 使用 EnvironmentFile。
PAPER_ROOT=/srv/papers
PAPER_HOST=127.0.0.1
PAPER_PORT=4186
PAPER_PASSWORD=
PAPER_PUBLIC_ORIGIN=
PAPER_AGENT_COMMAND=[]
PAPER_PROVIDER_MODE=auto
PAPER_AGENT_TIMEOUT=600
# OpenAI 兼容 Chat Completions Base URL（不含 /chat/completions）
PAPER_API_BASE_URL=
PAPER_API_MODEL=
PAPER_API_KEY=
PAPER_API_TIMEOUT=120
PAPER_API_JSON_MODE=1
# 网页保存的整理配置优先于以上 provider 环境变量，无需重启。
PAPER_SCHEDULE_ENABLED=0
PAPER_DAILY_TIME=03:00
PAPER_TIMEZONE=Asia/Shanghai
