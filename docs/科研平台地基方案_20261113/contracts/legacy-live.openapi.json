          "503": {
            "description": "Catalog unavailable"
          }
        }
      }
    },
    "/api/export.csv": {
      "get": {
        "summary": "Export standard metadata fields as formula-safe CSV",
        "responses": {
          "200": {
            "description": "CSV (UTF-8 with BOM)",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
