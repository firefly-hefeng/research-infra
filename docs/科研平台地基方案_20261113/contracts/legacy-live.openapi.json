    "/api/ingestion/status": {
      "get": {
        "summary": "Sanitized local rules-worker snapshot; never scans incoming or creates state",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "not-configured",
                        "planned",
                        "disabled",
                        "active",
                        "worker-stale"
                      ]
                    },
                    "counts": {
                      "type": "object",
                      "nullable": true
                    },
                    "jobs": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query"
          },
          "503": {
            "description": "Catalog unavailable"
          }
        }
