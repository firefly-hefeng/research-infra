+def provider_error(status, code):
+    if status == 429 or status >= 500 or code in (20050, 20072, 99991400):
+        return AuthError(503, "飞书身份服务暂不可用，请稍后重试")
+    if code in (20006, 99991677):
+        return AuthError(401, "飞书访问凭证已过期")
+    # Only invalidate a saved session on a definitive authorization failure.
+    if status in (401, 403) or code in (20003, 20004, 20005, 20007, 20008, 20009, 20010,
+            20021, 20022, 20023, 20024, 20026, 20037, 20064, 20066, 20073,
+            99991663, 99991668, 99991671, 99991673, 99991674, 99991679):
+        return AuthError(401, "飞书账号或授权已失效，请重新登录")
+    return AuthError(503, "暂时无法核验飞书身份，请稍后重试")
+
