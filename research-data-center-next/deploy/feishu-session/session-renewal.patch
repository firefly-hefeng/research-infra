+    def renew(self, key, row):
+        now = time.time()
+        if not row["refresh_token"] or row["refresh_expires"] <= now:
+            raise AuthError(401, "飞书登录授权已过期，请重新登录")
+        tokens = self.provider.refresh(row["refresh_token"])
+        token, new_refresh = tokens.get("access_token"), tokens.get("refresh_token")
+        access_seconds = int(tokens.get("expires_in") or 0)
+        refresh_seconds = int(tokens.get("refresh_token_expires_in") or 0)
+        if not token or not new_refresh or access_seconds <= 0 or refresh_seconds <= 0:
+            raise AuthError(401, "飞书未签发续期凭证，请重新登录")
+        # A refresh token rotates once. Save its successor before any later network call.
+        # verified=0 forces a membership check even after a temporary user_info failure.
+        with self.db() as db:
+            db.execute("UPDATE session_renewals SET refresh_token=?, refresh_expires=?, access_expires=? WHERE sid=?",
+                       (new_refresh, now + refresh_seconds, now + access_seconds, key))
+            db.execute("UPDATE sessions SET token=?,verified=0 WHERE sid=?", (token, key))
+        return token
