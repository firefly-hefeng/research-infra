[Unit]
Description=Immutable OSS release and consistent local SQLite snapshots
RequiresMountsFor=/data/share_cold /var/lib/research-data-center
After=network-online.target
[Service]
Type=oneshot
User=rmp
Group=rmp
WorkingDirectory=/var/lib/research-data-center/workspace
ExecStart=/data/services/miniforge3/bin/python /opt/research-data-center/releases/20261027-incoming-rules-mountfix/tools/cold_archive.py --root /var/lib/research-data-center/workspace --state-dir /var/lib/research-data-center/state
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/research-data-center/workspace /var/lib/research-data-center/state /data/share_cold/research-data-center
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=256M
TimeoutStartSec=1800
