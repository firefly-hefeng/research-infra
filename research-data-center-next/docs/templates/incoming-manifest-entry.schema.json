{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incoming file and directory manifest entry 2.0",
  "description": "Payload-relative file or directory; runtime rejects symlinks, special files, regular-file hardlinks, traversal and unstable contents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "path",
    "size_bytes",
    "sha256"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f]).+(?<!/)$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "file",
        "directory"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "file"
          }
        }
      },
      "then": {
        "properties": {
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "directory"
          }
        }
      },
      "then": {
        "properties": {
          "size_bytes": {
            "const": 0
          },
          "sha256": {
            "type": "null"
          }
        }
      }
    }
  ]
}
