  "newcomer_steps": [
    {
      "title": "01 · 先选疾病领域与资源角色",
      "description": "先确定研究领域，再区分原始数据、派生资料、特征、模型和实验工件。不同角色服务不同研究步骤。"
    },
    {
      "title": "02 · 读一张完整资料卡",
      "description": "查看背景、用途、任务、语言、当前路径和数量单位；再对照来源与待补事项。迁移计划、旧路径兼容与已核验当前位置分别阅读。"
    },
    {
      "title": "03 · 在自己的实验目录验证",
      "description": "取得相应使用权限后，用少量材料验证读取、转写或特征流程，记录资源ID、版本与配方；再开展完整实验。公共资料采用清册中已核验的当前位置；实验输出写入自己的工作区，不改公共原件。"
    }
  ],
  "terms": [
    {
      "term": "语料库 / corpus",
      "description": "为语言或交流研究收集的材料集合，可能包含录音、视频、转录和标注；某个本地镜像不一定包含全部组成部分。"
    },
    {
      "term": "声学特征与学习型表示",
      "description": "前者按预定义方法描述声音，后者由模型提取向量表示；二者都属于从原资料产生的特征，需要保留提取配置。"
    },
    {
      "term": "ASR 与强制对齐",
      "description": "ASR 从语音生成文字；强制对齐通常结合语音和已有文字定位时间边界。两种任务不能用同一输出假定替代。"
    },
    {
      "term": "登记记录 / 集合 / 版本",
      "description": "一条登记记录是目前的资料入口；集合可以包含多个语料，冻结版本才是可稳定复现的特定发布状态。"
    }
  ],
  "tips": [
    "数量先看单位：文件、音频、片段、参与者与目录记录是不同概念，不能互相代换。",
    "“经典”或“常用”应落实到具体语料与研究传统；本地保存、来源知名和质量验收是三件事。",
    "比较实验时先核对任务、语言、参与者切分和处理流程，避免把不同来源的差异误当成模型能力。",
    "公共区表示团队共享存放范围；许可、账户读取权限和研究用途仍以具体条目及来源条件为准。",
    "待确认只表示分类证据不足，不代表资料不可用；不得为了填满疾病类别而猜测。"
  ]
}
