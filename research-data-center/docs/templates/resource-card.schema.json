{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile": {
      "enum": [
        "draft",
        "legacy",
        "release"
      ]
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
        },
        "slug": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "dataset",
            "model",
            "collection",
            "feature",
            "annotation",
            "artifact"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "legacy_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "slug",
        "title",
        "kind",
        "summary",
        "tasks",
        "tags",
        "legacy_ids"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "upstream_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "origin": {
          "enum": [
            "original",
            "derived",
            "mixed",
            "unknown"
          ]
        },
        "state": {
          "enum": [
            "observed",
            "manifest_pinned",
            "content_frozen"
          ]
        },
        "metadata_revision": {
          "type": "integer",
          "minimum": 1
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "version",
        "upstream_revision",
        "origin",
        "state",
        "metadata_revision",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "maintainer": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "contact": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "display_name",
        "contact"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "upstream_repository",
              "publication",
              "local_contribution",
              "legacy_inventory",
              "unknown"
            ]
          },
          "reference": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "revision": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "acquired_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev-[a-z0-9-]+$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "kind",
          "reference",
          "revision",
          "acquired_at",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "rights": {
      "type": "object",
      "properties": {
        "metadata_visibility": {
          "enum": [
            "team",
            "restricted",
            "unknown"
          ]
        },
        "team_use": {
          "enum": [
            "allowed",
            "restricted",
            "unknown"
          ]
        },
        "external_distribution": {
          "enum": [
            "allowed",
            "conditional",
            "prohibited",
            "unknown"
          ]
        },
        "license_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "license_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[a-z0-9-]+$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "metadata_visibility",
        "team_use",
        "external_distribution",
        "license_id",
        "license_reference",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^/data/(?:share/)?(?:datasets|models)(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f]+)*/?$(?![\\s\\S])",
            "description": "Canonical targets are /data/share/datasets and /data/share/models. Old /data/datasets and /data/models paths remain valid as pre-cutover sources or explicitly verified legacy aliases. Schema acceptance never proves migration activation, readability, or publication; check receipts and resolved boundaries at runtime."
          },
          "role": {
            "enum": [
              "primary",
              "replica",
              "legacy"
            ]
          },
          "access": {
            "enum": [
              "readable",
              "restricted",
              "missing",
              "unknown"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev-[a-z0-9-]+$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "host_id",
          "path",
          "role",
          "access",
          "checked_at",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "derived_from",
              "fine_tuned_from",
              "variant_of",
              "supersedes",
              "uses_dataset"
            ]
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
          },
          "target_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev-[a-z0-9-]+$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "kind",
          "target_id",
          "target_ref",
          "version",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "properties": {
              "target_id": {
                "type": "string"
              }
            }
          },
          {
            "properties": {
              "target_ref": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "dataset": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sample_unit": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "sample_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "modalities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "splits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "count",
                  "unit"
                ],
                "additionalProperties": false
              }
            },
            "data_dictionary_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "collection_method": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "required": [
            "sample_unit",
            "sample_count",
            "languages",
            "modalities",
            "splits",
            "data_dictionary_ref",
            "collection_method"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "base_model": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "framework": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "architectures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "precision": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "input_description": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "output_description": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "loading_reference": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "evaluation_reference": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "required": [
            "base_model",
            "framework",
            "architectures",
            "precision",
            "input_description",
            "output_description",
            "loading_reference",
            "evaluation_reference"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "manifest": {
      "type": "object",
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*:)[^\\u0000-\\u001f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_coverage": {
          "enum": [
            "none",
            "partial",
            "full"
          ]
        },
        "file_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "path",
        "manifest_sha256",
        "content_coverage",
        "file_count",
        "total_bytes",
        "checked_at"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ev-[a-z0-9-]+$"
          },
          "kind": {
            "enum": [
              "source_document",
              "upstream_metadata",
              "filesystem_observation",
              "maintainer_statement",
              "computed_checksum",
              "processing_record"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "reference",
          "observed_at",
          "producer",
          "method",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "field_evidence": {
      "type": "object",
      "patternProperties": {
        "^/": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[a-z0-9-]+$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^/"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field",
          "reason",
          "next_action"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "profile",
    "resource",
    "release",
    "maintainer",
    "sources",
    "rights",
    "locations",
    "relations",
    "dataset",
    "model",
    "manifest",
    "evidence",
    "field_evidence",
    "unknowns"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Data Center Resource Card 1.0",
  "description": "Validates the JSON object parsed from README YAML front matter; not the Markdown body, content bytes, authority or filesystem confinement.",
  "allOf": [
    {
      "if": {
        "properties": {
          "resource": {
            "properties": {
              "kind": {
                "const": "dataset"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "dataset": {
            "type": "object",
            "properties": {
              "sample_unit": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "sample_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "modalities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "splits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "count": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "unit": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "count",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              },
              "data_dictionary_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "collection_method": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "required": [
              "sample_unit",
              "sample_count",
              "languages",
              "modalities",
              "splits",
              "data_dictionary_ref",
              "collection_method"
            ],
            "additionalProperties": false
          },
          "model": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource": {
            "properties": {
              "kind": {
                "const": "model"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "type": "object",
            "properties": {
              "base_model": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "framework": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "architectures": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "precision": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "input_description": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "output_description": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "loading_reference": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "evaluation_reference": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "required": [
              "base_model",
              "framework",
              "architectures",
              "precision",
              "input_description",
              "output_description",
              "loading_reference",
              "evaluation_reference"
            ],
            "additionalProperties": false
          },
          "dataset": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "enum": [
              "legacy",
              "release"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "legacy"
          }
        }
      },
      "then": {
        "properties": {
          "release": {
            "properties": {
              "state": {
                "const": "observed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "release"
          }
        }
      },
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "id": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            }
          },
          "release": {
            "properties": {
              "version": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "manifest_pinned",
                  "content_frozen"
                ]
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "maintainer": {
            "properties": {
              "id": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "contact": {
                "type": "string"
              }
            }
          },
          "sources": {
            "minItems": 1,
            "items": {
              "properties": {
                "kind": {
                  "not": {
                    "const": "unknown"
                  }
                },
                "reference": {
                  "type": "string"
                }
              }
            }
          },
          "rights": {
            "properties": {
              "metadata_visibility": {
                "const": "team"
              },
              "team_use": {
                "const": "allowed"
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          },
          "locations": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 1
          },
          "manifest": {
            "properties": {
              "path": {
                "type": "string"
              },
              "content_coverage": {
                "const": "full"
              },
              "manifest_sha256": {
                "type": "string"
              },
              "file_count": {
                "type": "integer"
              },
              "total_bytes": {
                "type": "integer"
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  ]
}
